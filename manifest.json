{
  "manifest_version": 3,
  "version": "8.0",
  "name": "Enhanced XReplyGPT - Victor T",
  "description": "A personal X reply assistant tuned to write concise, natural replies in Victor T's voice using the OpenAI API.",
  "icons": {
    "128": "src/images/XReplyGPT.png"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "commands": {
    "generate_reply": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Generate Victor-style replies for X posts."
    },
    "move_to_next_button": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Move to the next generated reply."
    },
    "move_to_previous_button": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Move to the previous generated reply."
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://x.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "src/index.html",
    "default_icon": "src/images/XReplyGPTbg.png"
  }
}
